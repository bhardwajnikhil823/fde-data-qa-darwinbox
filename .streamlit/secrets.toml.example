# Copy this file to .streamlit/secrets.toml and fill in real values.
# For Streamlit Community Cloud, paste these into the app's "Secrets" settings instead.

GROQ_API_KEY = "your-groq-api-key-here"

# Optional: only needed if you want persistent cloud storage via MotherDuck.
# Leave blank to use an in-memory DuckDB (fine for a single session demo).
MOTHERDUCK_TOKEN = ""
